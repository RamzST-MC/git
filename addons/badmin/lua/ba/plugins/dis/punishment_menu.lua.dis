net.Start("ba.RequestPlayersList")
net.SendToServer()
net.Receive("ba.SendPlayersList", function()
local players = net.ReadTable()
list:Clear()
for _, ply in ipairs(players) do
local steamid32 = NormalizeSteamID(ply.steamid)
local line = list:AddLine(ply.name, steamid32, ply.admin and "Админ" or "Игрок")
line.Paint = function(self, w, h)
if self:IsSelected() then
draw.RoundedBox(0, 0, 0, w, h, COLOR_ROW_SELECTED)
elseif self:IsHovered() then
draw.RoundedBox(0, 0, 0, w, h, COLOR_ROW_HOVER)
else
draw.RoundedBox(0, 0, 0, w, h, COLOR_ROW_BG_1)
end
end
if line.Columns then
for col = 1, #line.Columns do
local label = line.Columns[col]
if IsValid(label) then
label:SetFont("DermaDefault")
label:SetContentAlignment(4)
label:DockMargin(8, 0, 0, 0)
if col == 2 then
label:SetTextColor(COLOR_STEAMID)
elseif col == 3 then
label:SetTextColor(ply.admin and COLOR_ADMIN or COLOR_TEXT_DIM)
else
label:SetTextColor(COLOR_TEXT)
end
end
end
end
line.OnClick = function()
RunConsoleCommand("ba", "punishhistory", ply.steamid)
frame:Close()
end
line.OnDoubleClick = function()
SetClipboardText(steamid32)
ShowCopyNotification("SteamID: " .. steamid32)
frame:Close()
end
end
end)
searchEntry.OnValueChange = function(self, val)
val = string.lower(val)
for _, line in ipairs(list:GetLines()) do
local name = line:GetValue(1) or ""
local visible = string.find(string.lower(name), val, 1, true) ~= nil
line:SetVisible(visible)
end
end
return frame
end
local function ShowCopyNotification(text)
local notif = vgui.Create("DLabel")
notif:SetText("Скопировано: " .. text)
notif:SetFont("DermaDefaultBold")
notif:SetTextColor(Color(100, 255, 100))
notif:SizeToContents()
notif:SetPos(ScrW() / 2 - notif:GetWide() / 2, ScrH() - 100)
notif:MakePopup()
timer.Simple(2, function()
if IsValid(notif) then
notif:AlphaTo(0, 0.5, 0, function()
if IsValid(notif) then notif:Remove() end
end)
end
end)
end
local _allPunishments = {}
local _currentSteamID = ""
local _currentPunishType = "all"
