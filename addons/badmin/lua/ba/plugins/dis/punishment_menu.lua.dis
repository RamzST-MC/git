print("=== punishment_menu.lua ЗАГРУЖЕН (СЕРВЕР) ===")
local function NotifyPlayer(pl, text)
if IsValid(pl) and pl.ChatPrint then
pl:ChatPrint("[Наказания] " .. text)
end
end
local function ParseDuration(duration)
if not duration then return 0 end
local dur = tostring(duration)
local minutes = string.match(dur, "^(%d+)mi$")
if minutes then return tonumber(minutes) * 60 end
local hours = string.match(dur, "^(%d+)h$")
if hours then return tonumber(hours) * 3600 end
local days = string.match(dur, "^(%d+)d$")
if days then return tonumber(days) * 86400 end
local seconds = string.match(dur, "^(%d+)s$")
if seconds then return tonumber(seconds) end
local num = tonumber(dur)
if num then return num end
return 0
end
local PUNISH_TABLES = {
{type = "ban", tbl = "ba_bans", time = "ban_time"},
{type = "mute", tbl = "ba_mute_chat", time = "mute_time"},
{type = "voice_mute", tbl = "ba_mute_voice", time = "mute_time"},
}
local function GetPunishmentsFromDB(steamid, punish_type, cback)
local db = ba.data.GetDB()
local sid = tostring(steamid)
local steamid64 = string.match(sid, "^7656") and sid or util.SteamIDTo64(sid)
local sources = {}
for _, src in ipairs(PUNISH_TABLES) do
if punish_type == "all" or punish_type == src.type then
sources[#sources + 1] = src
end
end
if not db or #sources == 0 or not steamid64 or steamid64 == "0" then
cback({})
return
end
local results, pending, finished = {}, #sources, false
local function finish()
if finished then return end
finished = true
table.sort(results, function(a, b)
return (tonumber(a.ban_time or a.mute_time) or 0) > (tonumber(b.ban_time or b.mute_time) or 0)
end)
cback(results)
end
for _, src in ipairs(sources) do
db:query_ex("SELECT * FROM `" .. src.tbl .. "` WHERE steamid=\"?\" ORDER BY `" .. src.time .. "` DESC", {steamid64}, function(data)
if istable(data) then
for _, row in ipairs(data) do
row.punish_type = src.type
results[#results + 1] = row
end
end
pending = pending - 1
if pending <= 0 then finish() end
end)
end
timer.Simple(5, finish)
end
function ba.logs.OpenPlayerPunishments(pl, steamid, punish_type)
if not IsValid(pl) then return end
punish_type = punish_type or "all"
GetPunishmentsFromDB(steamid, punish_type, function(data)
if not IsValid(pl) then return end
if #data == 0 then
local type_names = {all = "наказаний", ban = "банов", mute = "мутов чата", voice_mute = "голосовых мутов"}
NotifyPlayer(pl, "У игрока нет " .. (type_names[punish_type] or "наказаний") .. ".")
return
end
net.Start("ba.OpenPunishmentsMenu")
net.WriteString(steamid)
net.WriteString(punish_type)
net.WriteTable(data)
net.Send(pl)
end)
end
local function FindPlayerByNick(query)
query = string.lower(query)
for _, ply in ipairs(player.GetAll()) do
if string.lower(ply:Nick()) == query then return ply end
end
for _, ply in ipairs(player.GetAll()) do
if string.find(string.lower(ply:Nick()), query, 1, true) then return ply end
end
return nil
end
local function GetPlayersList()
local list = {}
for _, ply in ipairs(player.GetAll()) do
list[#list + 1] = {
name = ply:Nick(),
steamid = ply:SteamID(),
userid = ply:UserID(),
admin = ply:IsAdmin() or ply:IsSuperAdmin()
}
end
return list
end
net.Receive("ba.RequestPlayersList", function(len, pl)
if not IsValid(pl) then return end
if not pl:IsAdmin() and not pl:IsSuperAdmin() then return end
local players = GetPlayersList()
net.Start("ba.SendPlayersList")
net.WriteTable(players)
net.Send(pl)
end)
local function ProcessCommand(pl, query, isAdmin, punish_type)
if isAdmin and not pl:IsAdmin() and not pl:IsSuperAdmin() then
NotifyPlayer(pl, "Только для администраторов!")
return
end
if not query or tostring(query) == "" then
net.Start("ba.OpenPlayerSelectMenu")
net.Send(pl)
return
end
query = tostring(query)
query = string.gsub(query, '"', '')
query = string.Trim(query)
local target = FindPlayerByNick(query)
if target then
query = target:SteamID()
end
if not string.find(query, "STEAM_", 1, true) and not string.find(query, "^7656", 1, true) then
NotifyPlayer(pl, "Неверный SteamID или игрок не найден: " .. query)
return
end
ba.logs.OpenPlayerPunishments(pl, query, punish_type)
end
if ba and ba.cmd then
ba.cmd.Create('punishhistory', function(pl, args)
local success, err = pcall(function()
local query = args.target or ""
ProcessCommand(pl, query, true, "all")
end)
if not success then
print("[punishhistory ERROR]", err)
end
return true
end)
:AddParam('string', 'target', true)
:SetFlag('ac')
:SetIcon('icon16/application_view_list.png')
:SetHelp('Открыть историю наказаний игрока')
:AddAlias('ph')
ba.cmd.Create('punishhistory_type', function(pl, args)
local success, err = pcall(function()
print("[DEBUG] punishhistory_type вызвана, args:", type(args))
local query = ""
local punish_type = "all"
if type(args) == "table" then
query = args[1] or args.target or ""
punish_type = args[2] or args.type or "all"
elseif type(args) == "string" then
local parts = string.Split(args, " ")
query = parts[1] or ""
punish_type = parts[2] or "all"
end
print("[DEBUG] query:", query, "punish_type:", punish_type)
if punish_type ~= "all" and punish_type ~= "ban" and punish_type ~= "mute" and punish_type ~= "voice_mute" then
punish_type = "all"
end
ProcessCommand(pl, query, true, punish_type)
end)
if not success then
print("[punishhistory_type ERROR]", err)
end
return true
end)
:AddParam('string', 'target', true)
:AddParam('string', 'type', true)
:SetFlag('ac')
:SetHelp('Открыть историю наказаний определённого типа')
ba.cmd.Create('playerpunishments', function(pl, args)
return true
end)
:SetFlag('M')
:SetHelp('История наказаний (требует флаг M)')
end
concommand.Add("ba_mypunish", function(pl, cmd, args)
if not IsValid(pl) then return end
local success, err = pcall(function()
ba.logs.OpenPlayerPunishments(pl, pl:SteamID(), "all")
end)
if not success then
print("[mypunish ERROR]", err)
end
end)
end
