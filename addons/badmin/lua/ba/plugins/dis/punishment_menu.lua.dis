local function IsEmptyValue(val)
if val == nil then return true end
if val == 0 then return true end
if val == "0" then return true end
if val == "NULL" then return true end
if val == "null" then return true end
if type(val) == "string" and string.Trim(val) == "" then return true end
return false
end
local function NormalizeSteamID(steamid)
if not steamid or steamid == "Неизвестно" or steamid == "0" then return "Неизвестно" end
local sid = tostring(steamid)
if string.match(sid, "^STEAM_0:%d+:%d+$") then return sid end
if string.match(sid, "^7656") then
local id64 = tonumber(sid)
if id64 then
local x = (id64 - 76561197960265728) % 2
local y = math.floor((id64 - 76561197960265728 - x) / 2)
return string.format("STEAM_0:%d:%d", x, y)
end
end
return sid
end
local function ParseDurationClient(duration)
if not duration then return 0 end
local dur = tostring(duration)
local minutes = string.match(dur, "^(%d+)mi$")
if minutes then return tonumber(minutes) * 60 end
local hours = string.match(dur, "^(%d+)h$")
if hours then return tonumber(hours) * 3600 end
local days = string.match(dur, "^(%d+)d$")
if days then return tonumber(days) * 86400 end
local seconds = string.match(dur, "^(%d+)s$")
if seconds then return tonumber(seconds) end
local num = tonumber(dur)
if num then return num end
return 0
end
local function FormatDurationShort(seconds)
if seconds <= 0 then return "Перм" end
if seconds >= 3600 * 24 then
return math.floor(seconds / (3600 * 24)) .. "д"
elseif seconds >= 3600 then
return math.floor(seconds / 3600) .. "ч"
elseif seconds >= 60 then
return math.floor(seconds / 60) .. "м"
else
return seconds .. "с"
end
end
