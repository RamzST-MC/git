_G.PunishmentsMenuFrame:Remove()
end
if not punish_type or punish_type == "" then
punish_type = "all"
end
_allPunishments = punishments or {}
_currentSteamID = steamid
_currentPunishType = punish_type
print("[CLIENT] Создание меню: steamid=", steamid, "type=", punish_type, "count=", #_allPunishments)
local frame = vgui.Create("DFrame")
